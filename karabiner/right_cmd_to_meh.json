{
  "title": "Right Cmd → Meh (Ctrl+Shift+Opt)",
  "rules": [
    {
      "description": "Right Cmd → Meh (Ctrl+Shift+Opt)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": ["left_control", "left_option"]
            }
          ]
        }
      ]
    }
  ]
}
